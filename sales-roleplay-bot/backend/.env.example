# Copy this file to .env and fill in your own values. Never commit .env.

# Required: Gemini API key with Live API access
GEMINI_API_KEY=your-gemini-api-key-here

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Gemini Live model used for the voice session
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Model used to grade the end-of-session Sales Coach report
COACH_MODEL=gemini-3.1-flash-lite
